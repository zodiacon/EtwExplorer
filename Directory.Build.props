<Project>

  <!-- Shared by every project in the solution (replaces the linked SharedAssemblyInfo.cs). -->
  <PropertyGroup>
	<Version>0.40.0</Version>
	<Copyright>© 2019 Pavel Yosifovch</Copyright>
	<Authors>Pavel Yosifovich</Authors>
	<Product>ETW Explorer</Product>
  </PropertyGroup>

  <PropertyGroup>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>
