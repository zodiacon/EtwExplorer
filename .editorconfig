root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,props,targets}]
indent_style = tab

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.cs]
charset = utf-8-bom
# Existing code style: K&R braces.
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false

# Modernization targets (C# 8 → 15); applied with `dotnet format --severity info`.
csharp_style_namespace_declarations = file_scoped:info
csharp_style_implicit_object_creation_when_type_is_apparent = true:info
csharp_style_prefer_not_pattern = true:info
csharp_style_prefer_pattern_matching = true:info
csharp_style_pattern_matching_over_as_with_null_check = true:info
csharp_style_pattern_matching_over_is_with_cast_check = true:info
csharp_prefer_simple_default_expression = true:info
csharp_prefer_simple_using_statement = true:info
csharp_style_prefer_index_operator = true:info
csharp_style_prefer_range_operator = true:info
dotnet_style_prefer_collection_expression = true:info
dotnet_style_predefined_type_for_locals_parameters_members = true:info
dotnet_style_predefined_type_for_member_access = true:info
dotnet_diagnostic.IDE0005.severity = suggestion
